---
/**
 * FinalCTA
 * --------
 * High-conversion WhatsApp CTA section.
 * Reused across Home, Método and Resultados.
 */
import VideoPlaceholder from "./VideoPlaceholder.astro";
import ricardoFront from "../assets/RicardoFront2.jpg";
import { mediaPath } from "../utils/paths";
---

<section id="valoracion" class="relative overflow-hidden bg-navy">
  <!-- Brand glow accents -->
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand/30 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:px-10 lg:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="text-white">
        <p class="eyebrow text-brand-200">Empieza aquí</p>
        <h2 class="mt-5 font-display text-4xl font-bold leading-[1.05] sm:text-5xl lg:text-6xl">
          Empieza con una<br />valoración personal
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-white/70">
          Hablemos de tu objetivo y veamos si este enfoque encaja contigo. Una
          conversación honesta, sin compromiso, para decidir el mejor punto de
          partida.
        </p>

        <a
          href="https://wa.me/34633729448?text=Hola%20Ricardo%2C%20me%20gustar%C3%ADa%20reservar%20una%20valoraci%C3%B3n."
          target="_blank"
          rel="noreferrer"
          class="mt-10 inline-flex items-center gap-3 rounded-full bg-[#25D366] px-9 py-5 text-lg font-semibold text-white shadow-lg shadow-[#25D366]/25 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1ebe5b] hover:shadow-xl hover:shadow-[#25D366]/35"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2zm0 18.06c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 01-1.26-4.34c0-4.54 3.7-8.23 8.24-8.23s8.23 3.69 8.23 8.23-3.69 8.2-8.23 8.2zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z" />
          </svg>
          Escríbeme por WhatsApp
        </a>
        <p class="mt-4 text-sm text-white/50">Te respondo personalmente en menos de 24 horas.</p>

        <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-white/10 pt-8">
          <div>
            <dt class="font-display text-3xl font-bold text-white">+20</dt>
            <dd class="mt-1 text-xs text-white/60">años de experiencia</dd>
          </div>
          <div>
            <dt class="font-display text-3xl font-bold text-white">+1000</dt>
            <dd class="mt-1 text-xs text-white/60">personas entrenadas</dd>
          </div>
          <div>
            <dt class="font-display text-3xl font-bold text-white">100%</dt>
            <dd class="mt-1 text-xs text-white/60">personalizado</dd>
          </div>
        </dl>
      </div>

      <!-- Auto-activates when the hero-training.mp4 file is added to public/media -->
      <div>
        <VideoPlaceholder
          fallbackImage={ricardoFront}
          alt="Ricardo Cobo entrenando a un cliente"
          videoPath={mediaPath("hero-training.mp4")}
          ratio="aspect-[4/5]"
        />
      </div>
    </div>
  </div>
</section>
