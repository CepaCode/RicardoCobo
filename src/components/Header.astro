---
// Premium sticky header with scroll-aware styling and mobile menu.
import logo from "../assets/imgLogoRCExtendidoFuenteAzul.png";
import { withBase } from "../utils/paths";

const navItems = [
  { label: "Inicio", href: withBase("") },
  { label: "El método", href: withBase("metodo") },
  { label: "Resultados", href: withBase("resultados") },
  { label: "Contacto", href: withBase("contacto") },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
  data-state="top"
>
  <div
    id="header-shell"
    class="border-b border-transparent transition-all duration-500"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-8 lg:px-10">
      <!-- Brand -->
      <a href={withBase("")} class="flex items-center gap-3" aria-label="Ricardo Cobo · Inicio">
        <img
          src={logo.src}
          alt="Ricardo Cobo · Entrenamiento Personal"
          class="h-9 w-auto sm:h-11"
          width={logo.width}
          height={logo.height}
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-6 xl:gap-9 lg:flex" aria-label="Navegación principal">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="group relative text-sm font-semibold tracking-wide text-navy/80 transition-colors hover:text-brand"
            >
              {item.label}
              <span class="absolute -bottom-1.5 left-0 h-0.5 w-0 bg-brand transition-all duration-300 group-hover:w-full" />
            </a>
          ))
        }
      </nav>

      <!-- Desktop CTA -->
      <a
        href="https://wa.me/34633729448?text=Hola%20Ricardo%2C%20me%20gustar%C3%ADa%20reservar%20una%20valoraci%C3%B3n."
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[#25D366]/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1ebe5b] hover:shadow-xl hover:shadow-[#25D366]/30 lg:inline-flex"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2zm0 18.06c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 01-1.26-4.34c0-4.54 3.7-8.23 8.24-8.23s8.23 3.69 8.23 8.23-3.69 8.2-8.23 8.2zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z" />
        </svg>
        Escríbeme por WhatsApp
      </a>

      <!-- Mobile toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-navy transition-colors hover:bg-haze lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="pointer-events-none fixed inset-0 z-40 translate-y-[-12px] bg-navy/98 opacity-0 backdrop-blur-xl transition-all duration-400 lg:hidden"
  >
    <div class="flex h-full flex-col px-6 pb-10 pt-24">
      <nav class="flex flex-col gap-1" aria-label="Navegación móvil">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="border-b border-white/10 py-5 font-display text-3xl font-bold text-white"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <a
        href="https://wa.me/34633729448?text=Hola%20Ricardo%2C%20me%20gustar%C3%ADa%20reservar%20una%20valoraci%C3%B3n."
        target="_blank"
        rel="noreferrer"
        class="mt-auto inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-6 py-4 text-base font-semibold text-white"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2zm0 18.06c-1.48 0-2.93-.4-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.16 8.16 0 01-1.26-4.34c0-4.54 3.7-8.23 8.24-8.23s8.23 3.69 8.23 8.23-3.69 8.2-8.23 8.2zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z" />
        </svg>
        Escríbeme por WhatsApp
      </a>
    </div>
  </div>
</header>

<!-- Spacer so fixed header never overlaps page content baseline on tall hero pages -->

<script is:inline>
  (function () {
    const header = document.getElementById("site-header");
    const shell = document.getElementById("header-shell");
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");

    const setSolid = (solid) => {
      if (!shell) return;
      if (solid) {
        shell.classList.add("bg-white/85", "backdrop-blur-xl", "shadow-sm");
        shell.classList.add("border-haze");
        shell.classList.remove("border-transparent");
      } else {
        shell.classList.remove("bg-white/85", "backdrop-blur-xl", "shadow-sm", "border-haze");
        shell.classList.add("border-transparent");
      }
    };

    const onScroll = () => setSolid(window.scrollY > 24);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    let open = false;
    const setMenu = (next) => {
      open = next;
      if (!menu || !toggle) return;
      toggle.setAttribute("aria-expanded", String(open));
      if (open) {
        menu.classList.remove("pointer-events-none", "opacity-0", "translate-y-[-12px]");
        menu.classList.add("opacity-100", "translate-y-0");
        document.body.style.overflow = "hidden";
      } else {
        menu.classList.add("pointer-events-none", "opacity-0", "translate-y-[-12px]");
        menu.classList.remove("opacity-100", "translate-y-0");
        document.body.style.overflow = "";
      }
    };

    toggle?.addEventListener("click", () => setMenu(!open));
    menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  })();
</script>
